@model List<Invoice_printer.Models.Party>

@{
    ViewData["Title"] = "Parties";
}

<div class="party-index-wrap">

    <div class="party-index-header">
        <h2 class="party-index-title">Parties</h2>
        <a class="btn btn-primary" asp-action="Create">Add Party</a>
    </div>

    @if (!Model.Any())
    {
        <div class="party-empty ui-empty">
            No parties found. Click <b>Add Party</b> to create one.
        </div>
    }
    else
    {
        <div class="party-card ui-table">
            <div class="table-responsive">
                <table class="table table-hover align-middle party-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Phone</th>
                            <th>Address</th>
                            <th>Email</th>
                            <th class="text-end" style="width: 220px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td>@p.Name</td>
                                <td>@(string.IsNullOrWhiteSpace(p.Phone) ? "-" : p.Phone)</td>
                                <td>@(string.IsNullOrWhiteSpace(p.Address) ? "-" : p.Address)</td>
                                <td class="text-end">
                                    <div class="party-actions">
                                        <a class="btn btn-sm btn-outline-secondary"
                                           asp-action="Edit"
                                           asp-route-id="@p.Id">Edit</a>

                                        <form asp-action="Delete"
                                              asp-route-id="@p.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Delete this party?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/party-index.css" asp-append-version="true" />
}