@{
    string C() => (ViewContext.RouteData.Values["controller"]?.ToString() ?? "");
    string A() => (ViewContext.RouteData.Values["action"]?.ToString() ?? "");

    string Active(string controller, string? action = null)
    {
        var ok = C().Equals(controller, StringComparison.OrdinalIgnoreCase);
        if (!string.IsNullOrWhiteSpace(action))
            ok = ok && A().Equals(action, StringComparison.OrdinalIgnoreCase);

        return ok ? "is-active" : "";
    }
}

