@model Invoice_printer.DTO_S.LoginDto

@{
    ViewData["Title"] = "Login";
}

<div class="login-page">
    <div class="login-card">

        <h2 class="login-title">Login</h2>

        <form asp-action="Login" method="post" novalidate>

            <div class="form-group">
                <label asp-for="UserNameOrEmail" class="form-label"></label>
                <input asp-for="UserNameOrEmail" class="form-control" />
                <span asp-validation-for="UserNameOrEmail" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" type="password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-actions">
                <div class="remember-me">
                    <input asp-for="RememberMe" type="checkbox" />
                    <label asp-for="RememberMe" class="mb-0"></label>
                </div>
            </div>

            <button type="submit" class="btn btn-primary btn-block">Login</button>

            <div asp-validation-summary="All" class="text-danger mt-3"></div>

        </form>

    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/auth-login.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}