@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer L
@inject Microsoft.Extensions.Localization.IStringLocalizer<Invoice_printer.Resources.SharedResource> SR
@model Invoice_printer.Models.Receipt
@using Invoice_printer.Models
@using Invoice_printer.extensions

@{
    ViewData["Title"] = L["Title"];
}

<div class="receipt-details-wrap">

    <div class="receipt-details-header">
        <h2 class="receipt-details-title">Receipt @Model.ReceiptNo</h2>

        <div class="receipt-actions">
            <a class="btn btn-outline-primary"
               asp-action="Export"
               asp-route-id="@Model.Id"
               asp-route-type="@ExportFileType.Pdf">
                @L["Actions_ExportPdf"]
            </a>

            <a class="btn btn-outline-secondary"
               asp-action="Export"
               asp-route-id="@Model.Id"
               asp-route-type="@ExportFileType.Png">
                @L["Actions_ExportPng"]
            </a>

            @if (Model.Status == ReceiptStatus.Draft)
            {
                <form asp-action="Finalize" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success"
                            onclick="return confirm('@L["ConfirmFinalize"]');">
                        @L["Actions_Finalize"]
                    </button>
                </form>

                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger"
                            onclick="return confirm('@L["ConfirmDelete"]');">
                        @L["Actions_Delete"]
                    </button>
                </form>
            }

            <a asp-action="Index" class="btn btn-secondary">@L["Actions_Back"]</a>
        </div>
    </div>

    <div class="receipt-info-card mb-3">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="meta-label">@L["Meta_Type"]</div>
                <div class="meta-value">@SR.LocalizeEnum(Model.Type)</div>
            </div>
            <div class="col-md-4">
                <div class="meta-label">@L["Meta_Date"]</div>
                <div class="meta-value">@Model.Date.ToString("yyyy-MM-dd")</div>
            </div>
            <div class="col-md-4">
                <div class="meta-label">@L["Meta_Status"]</div>
                <div>
                    @if (Model.Status == ReceiptStatus.Final)
                    {
                        <span class="badge bg-success">@SR.LocalizeEnum(ReceiptStatus.Final)</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@SR.LocalizeEnum(ReceiptStatus.Draft)</span>
                    }
                </div>
            </div>
        </div>

        <hr />

        <div class="row g-3">
            <div class="col-md-6">
                <div class="meta-label">@L["Meta_Party"]</div>
                <div class="meta-value">@(Model.Party?.Name ?? "-")</div>
            </div>
            <div class="col-md-6">
                <div class="meta-label">@L["Meta_Template"]</div>
                <div class="meta-value">@(Model.Template?.Name ?? "-")</div>
            </div>
        </div>

        <hr />

        <div class="row g-3">
            <div class="col-md-6">
                <div class="meta-label">@L["Meta_Amount"]</div>
                <div class="amount-big">@Model.Amount.ToString("0.##") @Model.Currency</div>
            </div>
            <div class="col-md-6">
                <div class="meta-label">@L["Meta_PaymentMethod"]</div>
                <div class="meta-value">
                    @(Model.PaymentMethod == PaymentMethod.None ? "-" : SR.LocalizeEnum(Model.PaymentMethod))
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <hr />
            <div>
                <div class="meta-label">@L["Meta_Description"]</div>
                <div>@Model.Description</div>
            </div>
        }
    </div>

    @if (Model.Items != null && Model.Items.Any())
    {
        <h4 class="section-title">@L["Section_Items"]</h4>

        <div class="receipt-info-card mb-3 p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle items-table">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th class="text-end">Qty</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Line Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var it in Model.Items)
                        {
                            <tr>
                                <td>@it.Title</td>
                                <td class="text-end">@it.Quantity</td>
                                <td class="text-end">@it.UnitPrice.ToString("0.##")</td>
                                <td class="text-end">@it.LineTotal.ToString("0.##")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (Model.Exports != null && Model.Exports.Any())
    {
        <h4 class="section-title">@L["Section_Exports"]</h4>

        <div class="receipt-info-card exports-list p-0">
            <ul class="list-group list-group-flush">
                @foreach (var ex in Model.Exports.OrderByDescending(x => x.CreatedAt))
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center gap-3">
                        <div>
                            <b>@ex.FileType</b>
                            <div class="text-muted small">@ex.CreatedAt.ToString("yyyy-MM-dd HH:mm")</div>
                        </div>
                        <span class="text-muted small exports-path">@ex.FilePath</span>
                    </li>
                }
            </ul>
        </div>
    }

</div>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/receipt-details.css" asp-append-version="true" />
}