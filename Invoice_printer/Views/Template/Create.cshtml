@model Invoice_printer.DTO_S.TemplateCreateDto
@using Invoice_printer.Models
@using Invoice_printer.extensions
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer L
@inject Microsoft.Extensions.Localization.IStringLocalizer<Invoice_printer.Resources.SharedResource> SR

@{
    ViewData["Title"] = L["Title"];
}

<div class="template-form-wrap">
    <h2 class="template-form-title">@L["Heading"]</h2>

    <form asp-action="Create" method="post" enctype="multipart/form-data" class="template-form-card">
        @Html.AntiForgeryToken()

        <!-- ===== Basic Info ===== -->
        <div class="section-head">
            <h4 class="section-title">@L["BasicInfo"]</h4>
            <div class="help-hint">@L["BasicInfoHint"]</div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Type" class="form-label"></label>
                <select asp-for="Type" class="form-select">
                    <option value="">@L["Select"]</option>
                    @foreach (var item in SR.ToLocalizedSelectList<ReceiptType>())
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                </select>
                <span asp-validation-for="Type" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="TemplateMode" class="form-label"></label>
            <select asp-for="TemplateMode" id="templateMode" class="form-select">
                <option value="">@L["Select"]</option>
                @foreach (var item in SR.ToLocalizedSelectList<TemplateMode>())
                {
                    <option value="@item.Value">@item.Text</option>
                }
            </select>
            <span asp-validation-for="TemplateMode" class="text-danger"></span>
        </div>

        <div class="section-line"></div>

        <!-- ===== HTML Template ===== -->
        <div class="section-head">
            <h4 class="section-title">@L["HtmlTemplate"]</h4>
            <div class="help-hint">@L["HtmlTemplateHint"]</div>
        </div>

        <div class="mb-3" id="htmlBox" style="display:none;">
            <label asp-for="HtmlContent" class="form-label">@L["HtmlTemplate"]</label>
            <textarea asp-for="HtmlContent"
                      class="form-control"
                      rows="14"
                      placeholder="@L["HtmlPlaceholder"]"></textarea>
            <span asp-validation-for="HtmlContent" class="text-danger"></span>

            <div class="mt-2 code-box">
                @L["Placeholders"]:
                <code>{{CompanyName}}</code>,
                <code>{{CompanyAddres}}</code>,
                <code>{{LogoUrl}}</code>,
                <code>{{ReceiptNo}}</code>,
                <code>{{ItemsRows}}</code>,
                <code>{{Total}}</code>
            </div>
        </div>

        <div class="section-line"></div>

        <!-- ===== Background / Settings ===== -->
        <div class="section-head">
            <h4 class="section-title">@L["BackgroundSettings"]</h4>
            <div class="help-hint">@L["Optional"]</div>
        </div>

        <div class="mb-3" id="bgBox">
            <label asp-for="BackgroundImageFile" class="form-label">@L["BackgroundImageOptional"]</label>
            <input asp-for="BackgroundImageFile" type="file" class="form-control" accept="image/*" />
            <span asp-validation-for="BackgroundImageFile" class="text-danger"></span>
            <div class="form-text">@L["BackgroundImageHint"]</div>
        </div>

        <div class="mb-3" id="jsonBox">
            <label asp-for="SettingsJson" class="form-label"></label>
            <textarea asp-for="SettingsJson"
                      class="form-control"
                      rows="4"
                      placeholder="@L["SettingsPlaceholder"]"></textarea>
            <span asp-validation-for="SettingsJson" class="text-danger"></span>
        </div>

        <div class="form-check mb-3">
            <input asp-for="IsDefault" class="form-check-input" />
            <label asp-for="IsDefault" class="form-check-label"></label>
        </div>

        <div class="template-form-actions">
            <button type="submit" class="btn btn-primary">@L["Save"]</button>
            <a asp-action="Index" class="btn btn-secondary">@L["Cancel"]</a>
        </div>
    </form>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/template-form.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const modeSelect = document.getElementById('templateMode');
            const htmlBox = document.getElementById('htmlBox');

            function sync() {
                const selectedOption = modeSelect.options[modeSelect.selectedIndex];
                const modeText = (selectedOption?.text || '').toLowerCase();

                const isPlaceholder = !modeSelect.value;
                const isHtml = !isPlaceholder && modeText.includes('html');

                htmlBox.style.display = isHtml ? 'block' : 'none';
            }

            modeSelect.addEventListener('change', sync);
            sync();
        })();
    </script>
}