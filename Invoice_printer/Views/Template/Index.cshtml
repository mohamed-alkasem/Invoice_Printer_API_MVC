@model List<Invoice_printer.Models.Template>
@using Invoice_printer.Models

@{
    ViewData["Title"] = "Templates";
    var selectedType = ViewBag.Type as ReceiptType?;
}

<div class="template-index-wrap">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Templates</h2>
        <a class="btn btn-primary" asp-action="Create">Add Template</a>
    </div>

    <div class="mb-3">
        <a class="btn btn-outline-secondary @(selectedType == null ? "active" : "")"
           asp-action="Index"
           asp-route-type="">
            All
        </a>

        <a class="btn btn-outline-secondary @(selectedType == ReceiptType.Collection ? "active" : "")"
           asp-action="Index"
           asp-route-type="@ReceiptType.Collection">Collection</a>

        <a class="btn btn-outline-secondary @(selectedType == ReceiptType.Payment ? "active" : "")"
           asp-action="Index"
           asp-route-type="@ReceiptType.Payment">Payment</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No templates found.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Mode</th>
                        <th>Default</th>
                        <th class="text-end" style="width:220px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td>@t.Name</td>
                            <td>@t.Type</td>
                            <td>@t.TemplateMode</td>
                            <td>
                                @if (t.IsDefault)
                                {
                                    <span class="badge bg-success">Default</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No</span>
                                }
                            </td>
                            <td class="text-end">

                                @if (!t.IsDefault)
                                {
                                    <form asp-action="SetDefault"
                                          asp-route-id="@t.Id"
                                          method="post"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-success">
                                            Set Default
                                        </button>
                                    </form>
                                }

                                <a class="btn btn-sm btn-outline-secondary"
                                   asp-action="Edit"
                                   asp-route-id="@t.Id">
                                    Edit
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@t.Id"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Delete this template?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </button>
                                </form>

                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/template-index.css" asp-append-version="true" />
}