@model Invoice_printer.DTO_S.TemplateUpdateDto
@using Invoice_printer.Models
@using Invoice_printer.extensions
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer L
@inject Microsoft.Extensions.Localization.IStringLocalizer<Invoice_printer.Resources.SharedResource> SR

@{
    ViewData["Title"] = L["Title"];
}

<div class="template-form-wrap">
    <h2 class="template-form-title">@L["Heading"]</h2>

    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="template-form-card">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <!-- ===== Basic Info ===== -->
        <div class="section-head">
            <h4 class="section-title">@L["BasicInfo"]</h4>
            <div class="help-hint">@L["BasicInfoHint"]</div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label asp-for="Type" class="form-label"></label>
                <select asp-for="Type"
                        class="form-select"
                        asp-items="SR.ToLocalizedSelectList<ReceiptType>(Model.Type)">
                </select>
                <span asp-validation-for="Type" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="TemplateMode" class="form-label"></label>
            <select asp-for="TemplateMode"
                    id="templateMode"
                    class="form-select"
                    asp-items="SR.ToLocalizedSelectList<TemplateMode>(Model.TemplateMode)">
            </select>
            <span asp-validation-for="TemplateMode" class="text-danger"></span>
        </div>

        <div class="section-line"></div>

        <!-- ===== HtmlContent ===== -->
        <div class="section-head">
            <h4 class="section-title">@L["HtmlTemplate"]</h4>
            <div class="help-hint">@L["HtmlTemplateHint"]</div>
        </div>

        <div class="mb-3" id="htmlBox">
            <label asp-for="HtmlContent" class="form-label">@L["HtmlTemplate"]</label>
            <textarea asp-for="HtmlContent" class="form-control" rows="14"></textarea>
            <span asp-validation-for="HtmlContent" class="text-danger"></span>
        </div>

        <div class="section-line"></div>

        <!-- ===== Background Image ===== -->
        <div class="section-head">
            <h4 class="section-title">@L["BackgroundImage"]</h4>
            <div class="help-hint">@L["Optional"]</div>
        </div>

        <div class="mb-3" id="bgBox">
            <label class="form-label">@L["BackgroundImage"]</label>

            @if (!string.IsNullOrWhiteSpace(Model.BackgroundImagePath))
            {
                <div class="preview-box mb-2">
                    <img src="@Model.BackgroundImagePath" alt="Background Preview" />
                </div>

                <div class="form-check mb-2">
                    <input asp-for="RemoveBackground" class="form-check-input" />
                    <label asp-for="RemoveBackground" class="form-check-label">@L["RemoveBackground"]</label>
                </div>
            }

            <input asp-for="BackgroundImageFile" type="file" class="form-control" accept="image/*" />
            <span asp-validation-for="BackgroundImageFile" class="text-danger"></span>

            <div class="form-text">
                @L["BackgroundReplaceHint"]
            </div>
        </div>

        <!-- ===== Settings Json ===== -->
        <div class="mb-3" id="jsonBox">
            <label asp-for="SettingsJson" class="form-label"></label>
            <textarea asp-for="SettingsJson" class="form-control" rows="4"></textarea>
            <span asp-validation-for="SettingsJson" class="text-danger"></span>
        </div>

        <div class="form-check mb-3">
            <input asp-for="IsDefault" class="form-check-input" />
            <label asp-for="IsDefault" class="form-check-label"></label>
        </div>

        <div class="template-form-actions">
            <button type="submit" class="btn btn-primary">@L["Update"]</button>
            <a asp-action="Index" class="btn btn-secondary">@L["Cancel"]</a>
        </div>
    </form>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/template-form.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const modeSelect = document.getElementById('templateMode');
            const htmlBox = document.getElementById('htmlBox');

            function sync() {
                const modeText = (modeSelect.options[modeSelect.selectedIndex]?.text || '').toLowerCase();
                const isHtml = modeText.includes('html');
                htmlBox.style.display = isHtml ? 'block' : 'none';
            }

            modeSelect.addEventListener('change', sync);
            sync();
        })();
    </script>
}